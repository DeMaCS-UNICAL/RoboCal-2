<Simulation>
  <Include href="Includes/NaoV6H25.rsi3"/>
  <Include href="Includes/Ball2016SPL.rsi3"/>
  <Include href="Includes/Field2020SPLHalf.rsi3"/>
  
  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.012" color="rgb(65%, 65%, 70%)">
    <PointLight z="9m" ambientColor="rgb(50%, 50%, 50%)"/>

    <Compound name="teams">
      <Compound name="B-Human">
        <Compound name="5"/>
        <Compound name="black"/>
        <Compound name="purple"/>
      </Compound>
      <Compound name="B-Team">
        <Compound name="70"/>
        <Compound name="red"/>
        <Compound name="blue"/>
      </Compound>
    </Compound>

    <Compound name="robots">
      <Body ref="Nao" name="robot5">
        <Translation x="1.0" y="0" z="320mm"/>
        <Rotation z="0degree"/>
        <Set name="TeamColor" value="black"/>
      </Body>
    </Compound>

    <Compound name="balls">
      <Body ref="ball">
        <Translation x="2.0" y="0" z="60mm"/>
      </Body>
    </Compound>

    <Compound ref="field"/>
  </Scene>
</Simulation>
