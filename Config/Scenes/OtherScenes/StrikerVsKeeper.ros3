<Simulation>

  <Include href="../Includes/NaoV6H25.rsi3"/>
  <Include href="../Includes/Ball2016SPL.rsi3"/>
  <Include href="../Includes/Field2020SPL.rsi3"/>

  <Compound name="robots">
    <!-- PORTIERE: B-Human numero 1 -> isGoalkeeper. Davanti alla propria porta (lato -x). -->
    <Body ref="Nao" name="robot1">
      <Translation x="-4.0" z="320mm"/>
      <Rotation z="0degree"/>
      <Set name="TeamColor" value="purple"/>
    </Body>
    <!-- ATTACCANTE: B-Team numero 5. Tira verso la porta B-Human (-x). -->
    <Body ref="Nao" name="robot25">
      <Translation x="-1.0" z="320mm"/>
      <Rotation z="180degree"/>
      <Set name="TeamColor" value="red"/>
    </Body>
  </Compound>



  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.012" color="rgb(65%, 65%, 70%)">
    <PointLight z="9m" ambientColor="rgb(50%, 50%, 50%)"/>

    <Compound name="teams">
      <Compound name="B-Human">
        <Compound name="5"/>
        <Compound name="black"/>
        <Compound name="purple"/>
      </Compound>
      <Compound name="B-Team">
        <Compound name="70"/>
        <Compound name="red"/>
        <Compound name="blue"/>
      </Compound>
    </Compound>

    <Compound ref="robots"/>

    <Compound name="balls">
      <Body ref="ball">
        <Translation x="-1.5" z="1m"/>
      </Body>
    </Compound>

    <Compound ref="field"/>

    <Compound name="scenarios">
      <Compound name="AnyPlaceDemo"/>
    </Compound>

  </Scene>
</Simulation>
