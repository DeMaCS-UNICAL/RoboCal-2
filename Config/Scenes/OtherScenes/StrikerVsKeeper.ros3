<Simulation>

  <Include href="../Includes/NaoV6H25.rsi3"/>
  <Include href="../Includes/Ball2016SPL.rsi3"/>
  <Include href="../Includes/Field2020SPL.rsi3"/>

  <Compound name="robots">
    <!-- PORTIERE: B-Human numero 1 -> isGoalkeeper. Messo nella porta AVVERSARIA (+x), dove tira l'attaccante. -->
    <Body ref="Nao" name="robot1">
      <Translation x="4.0" z="320mm"/>
      <Rotation z="180degree"/>       <!-- guarda verso -x, cioe' verso il campo/attaccante -->
      <Set name="TeamColor" value="purple"/>
    </Body>
    <!-- ATTACCANTE: B-Human numero 5 (COMPAGNO del portiere). Attacca la porta avversaria (+x) = verso il portiere. -->
    <Body ref="Nao" name="robot5">
      <Translation x="1.0" z="320mm"/>
      <Rotation z="0degree"/>          <!-- guarda verso +x, cioe' verso la porta avversaria/portiere -->
      <Set name="TeamColor" value="black"/>
    </Body>
  </Compound>



  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.012" color="rgb(65%, 65%, 70%)">
    <PointLight z="9m" ambientColor="rgb(50%, 50%, 50%)"/>

    <Compound name="teams">
      <Compound name="B-Human">
        <Compound name="5"/>
        <Compound name="black"/>
        <Compound name="purple"/>
      </Compound>
      <Compound name="B-Team">
        <Compound name="70"/>
        <Compound name="red"/>
        <Compound name="blue"/>
      </Compound>
    </Compound>

    <Compound ref="robots"/>

    <Compound name="balls">
      <Body ref="ball">
        <Translation x="1.5" z="1m"/>
      </Body>
    </Compound>

    <Compound ref="field"/>

    <Compound name="scenarios">
      <Compound name="DemoDuel"/>
    </Compound>

  </Scene>
</Simulation>
